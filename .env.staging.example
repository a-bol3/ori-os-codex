# Copy to /opt/orios-staging/.env.staging on the staging host.
# Use staging-only credentials, URLs and data. Never copy production values here.

NODE_ENV=production
POSTGRES_USER=ori_staging
POSTGRES_PASSWORD=replace-with-a-staging-password
POSTGRES_DB=ori_os_staging
DATABASE_URL=postgresql://ori_staging:replace-with-a-staging-password@postgres:5432/ori_os_staging?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=replace-with-a-staging-meilisearch-key
MEILI_MASTER_KEY=replace-with-a-staging-meilisearch-key
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ori-staging
S3_SECRET_KEY=replace-with-a-staging-storage-secret
S3_BUCKET=ori-os-staging
S3_REGION=us-east-1
MINIO_ROOT_USER=ori-staging
MINIO_ROOT_PASSWORD=replace-with-a-staging-storage-secret

NEXT_PUBLIC_APP_URL=https://staging.orios.ori-craftlabs.com
NEXT_PUBLIC_API_URL=https://staging-api.orios.ori-craftlabs.com
NEXTAUTH_URL=https://staging.orios.ori-craftlabs.com
NEXTAUTH_SECRET=replace-with-a-staging-nextauth-secret
AUTH_SECRET=replace-with-a-staging-auth-secret
JWT_SECRET=replace-with-a-staging-jwt-secret
ENCRYPTION_KEY=replace-with-a-staging-32-byte-hex-key
ENCRYPTION_MASTER_KEY=replace-with-a-staging-32-byte-hex-key
WEBHOOK_SECRET=replace-with-a-staging-webhook-secret
ORI_AUTH_BYPASS=0
NEXT_PUBLIC_AUTH_BYPASS=0
ORI_DEV_USER_ID=
ORI_DEV_ORGANIZATION_ID=
ORI_DEV_USER_EMAIL=
ORI_SEED_ADMIN_EMAIL=admin@staging.ori-craftlabs.com
ORI_SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
ORI_ALLOW_PRODUCTION_SEED=0
ORI_ALLOW_SELF_SERVICE_REGISTRATION=false

ENABLE_AI_SIMULATION=false
ENABLE_EMAIL_FIXTURES=false
ENABLE_BILLING_FIXTURES=false
ENABLE_SEO_FIXTURES=false
ENABLE_EXTERNAL_AI_PII=false
ENABLE_TEST_BENCH=false
ENABLE_OPERATIONS_CORE=true
NEXT_PUBLIC_ENABLE_OPERATIONS_CORE=true
NEXT_PUBLIC_ENABLE_ANALYTICS_FIXTURES=false
NEXT_PUBLIC_ENABLE_SEO_FIXTURES=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.orios.ori-craftlabs.com/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
MAILGUN_API_KEY=
FROM_EMAIL=staging@ori-craftlabs.com
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
ZEROBOUNCE_API_KEY=
SENTRY_DSN=
