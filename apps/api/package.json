    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/throttler": "^6.3.0",
    "@ori-os/core": "0.1.0",
    "@ori-os/db": "0.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^8.21.0",
    "@sentry/profiling-node": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.7.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "helmet": "^8.1.0",
    "openai": "^6.21.0",
    "passport": "^0.7.0",
