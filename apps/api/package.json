{
  "name": "@ori-os/api",
  "version": "0.1.0",
  "description": "Ori-OS Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node ../../node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "dev": "tsx watch src/main.ts",
    "start:debug": "node ../../node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node ../../node_modules/jest/bin/jest.js",
    "test:watch": "node ../../node_modules/jest/bin/jest.js --watch",
    "test:cov": "node ../../node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node ../../node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
