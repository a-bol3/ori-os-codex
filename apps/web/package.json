{
    "name": "@ori-os/web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "cross-env DOTENV_CONFIG_PATH=../../.env node -r dotenv/config ../../node_modules/next/dist/bin/next dev --turbo",
        "build": "cross-env DOTENV_CONFIG_PATH=../../.env node -r dotenv/config ../../node_modules/next/dist/bin/next build",
        "start": "cross-env DOTENV_CONFIG_PATH=../../.env node -r dotenv/config ../../node_modules/next/dist/bin/next start",
        "lint": "cross-env DOTENV_CONFIG_PATH=../../.env ESLINT_USE_FLAT_CONFIG=false node -r dotenv/config ../../node_modules/next/dist/bin/next lint",
        "test": "node ../../node_modules/vitest/vitest.mjs run",
        "test:watch": "node ../../node_modules/vitest/vitest.mjs",
        "clean": "node -e \"const fs=require('fs');['.next','node_modules','.turbo'].forEach((dir)=>fs.rmSync(dir,{recursive:true,force:true}))\""
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.1",
        "@ori-os/db": "0.1.0",
        "@ori-os/ui": "0.1.0",
        "@sentry/nextjs": "^10.38.0",
        "@tanstack/react-query": "^5.17.19",
        "bcrypt": "^6.0.0",
        "date-fns": "^4.1.0",
        "framer-motion": "^11.0.3",
        "imapflow": "1.5.0",
        "lucide-react": "^0.321.0",
        "next": "^15.0.0",
        "next-auth": "^5.0.0-beta.30",
        "next-themes": "^0.2.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^2.12.0",
        "sonner": "^2.0.7",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/bcrypt": "6.0.0",
        "@types/node": "^20.11.0",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-config-next": "^15.0.0",
        "jsdom": "^28.1.0",
        "postcss": "^8.4.33",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vitest": "^4.0.18"
    }
}
