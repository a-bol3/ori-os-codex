# --- Database (Docker Postgres) ---
DATABASE_URL="postgresql://ori:ori_password@127.0.0.1:5432/ori_os?schema=public"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID="525982992399-REDACTED.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-REDACTED"
GOOGLE_REDIRECT_URI="https://ori-os.ori-craftlabs.com/api/seo/gsc/callback/google"

GITHUB_CLIENT_ID="REDACTED"
GITHUB_CLIENT_SECRET="REDACTED"

# AI Providers (Optional - stub works without these)
ANTHROPIC_API_KEY="sk-ant-REDACTED"

# Email (Optional - local mode works without)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# --- NextAuth (only needed when ORI_AUTH_BYPASS is OFF) ---
NEXTAUTH_URL="http://ori-os.ori-craftlabs.com"
NEXTAUTH_SECRET="REDACTED"

# Redis
REDIS_URL="redis://redis:6379"
REDIS_API_KEY="REDACTED"

# --- Dev convenience ---
# When enabled, /app is accessible without login and API calls create/use a dev user (id=dev)
ORI_AUTH_BYPASS="0"

# --- External Services (Simulation Mode Enabled) ---
OPENAI_API_KEY="sk-svcacct-REDACTED"
RESEND_API_KEY="re_REDACTED"
MAILGUN_API_KEY="REDACTED"
SLACK_WEBHOOK_URL="REDACTED"
FROM_EMAIL="onboarding@resend.dev"
STRIPE_SECRET_KEY="sk_test_REDACTED"
STRIPE_PUBLIC_KEY="pk_test_REDACTED"
STRIPE_WEBHOOK_SECRET="whsec_REDACTED"
STRIPE_PRO_PRICE_ID="price_REDACTED"

HOSTINGER_API_TOKEN="REDACTED"
HOSTINGER_VPS_ID="REDACTED"

ZEROBOUNCE_API_KEY="REDACTED"

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://ori-os.ori-craftlabs.com
NEXT_PUBLIC_API_URL=http://api.ori-os.ori-craftlabs.com
API_URL=http://ori-os.ori-craftlabs.com

# Search (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# Storage (Optional - local filesystem used by default)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ori-os-dev"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Encryption
ENCRYPTION_KEY="REDACTED"
ENCRYPTION_MASTER_KEY="REDACTED"

# Sentry (Observability)
SENTRY_DSN="REDACTED"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="1.0"
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================
# CORE APPLICATION
# ============================================
# SECURITY & ENCRYPTION
# ============================================
JWT_SECRET=REDACTED
ENCRYPTION_KEY=REDACTED
ENCRYPTION_MASTER_KEY=REDACTED
WEBHOOK_SECRET=REDACTED

