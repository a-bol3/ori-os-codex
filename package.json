{
  "name": "ori-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:local": "npm run dev:reset && concurrently -n web,api -c magenta,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:up": "docker-compose -f docker-compose.dev.yml up -d --build",
    "dev:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "prod:up": "docker-compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker-compose -f docker-compose.prod.yml down",
    "prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "prod:migrate": "docker-compose -f docker-compose.prod.yml exec api npx prisma migrate deploy",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "clean": "turbo run clean && node scripts/dev-reset.mjs --node-modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npm run db:generate --workspace=@ori-os/db",
    "db:push": "npm run db:push --workspace=@ori-os/db",
    "db:migrate": "npm run db:migrate --workspace=@ori-os/db"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.58.2",
    "cross-env": "^7.0.3",
    "@types/node": "^20.11.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.2.4",
    "prisma": "^6.11.1",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "eslint": "^8.57.1",
    "jest-util": "30.4.1",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cheerio": "^1.2.0"
  }
}
