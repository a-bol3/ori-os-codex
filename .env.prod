# --- ORI-OS Production Environment ---
NODE_ENV=production
ORI_AUTH_BYPASS=0

# URLs
APP_URL=http://ori-os.ori-craftlabs.com
API_URL=https://api.ori-os.ori-craftlabs.com
NEXT_PUBLIC_APP_URL=http://ori-os.ori-craftlabs.com
NEXT_PUBLIC_API_URL=https://api.ori-os.ori-craftlabs.com

# Database & Redis (Internal Docker hosts)
DATABASE_URL=postgresql://ori:ori_password@postgres:5432/ori_os
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication
NEXTAUTH_SECRET=REDACTED_FOR_PUSH_FIX
NEXTAUTH_URL=http://ori-os.ori-craftlabs.com
JWT_SECRET=REDACTED_FOR_PUSH_FIX
JWT_EXPIRES_IN=7d

# Security
ENCRYPTION_MASTER_KEY=REDACTED_FOR_PUSH_FIX
WEBHOOK_SECRET=REDACTED_FOR_PUSH_FIX

# Storage & Search
MEILI_MASTER_KEY=REDACTED_FOR_PUSH_FIX
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REDACTED_FOR_PUSH_FIX

# External API Keys (Provided)
RESEND_API_KEY=re_REDACTED_FOR_PUSH_FIX
STRIPE_SECRET_KEY=sk_test_REDACTED_FOR_PUSH_FIX
STRIPE_PUBLISHABLE_KEY=pk_test_REDACTED_FOR_PUSH_FIX
STRIPE_WEBHOOK_SECRET=whsec_REDACTED_FOR_PUSH_FIX

# Google / SEO (Provided)
GOOGLE_CLIENT_ID=525982992399-REDACTED_FOR_PUSH_FIX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REDACTED
GOOGLE_REDIRECT_URI=https://api.ori-craftlabs.com/api/seo/gsc/callback

# SEO Settings
SEO_CRAWL_CONCURRENCY=3
SEO_CRAWL_RATE_LIMIT=1000
SEO_RANKING_CHECK_INTERVAL=0 2 * * *
SEO_GSC_SYNC_INTERVAL=0 3 * * *
